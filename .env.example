SNIPE_API_TOKEN=your_snipe_api_token
SNIPE_URL=https://cphutils.temple.edu/equipment/api/v1
 
# System Settings
CURRENT_CSV=current_scan.csv
COMPLETED_FOLDER=completed_scans
 
# EXACT Headers for CRC Submission
CSV_HEADERS=Equipment Type,Item Description,Serial Number,Temple Tag
 
# Tuning
CACHE_TTL_SECONDS=60
SNIPE_VERIFY_SSL=true
SNIPE_TIMEOUT_SECONDS=5

# Microsoft Entra ID / Temple SSO (CPH-SoftwareMgmt)
SSO_TENANT_ID=716e81ef-b522-4473-8e31-10bd02ccf6e5
SSO_CLIENT_ID=28e809ea-19ba-4028-89c7-c1d016e4836c
SSO_CLIENT_SECRET=your_client_secret_here
SSO_REDIRECT_URI=
SSO_ENABLED=true

# Authorized AD/Entra Groups (comma-separated Object IDs)
ALLOWED_ADMIN_GROUPS=afd02e22-938a-49ae-b86b-660f8bb70f5b,9d5bcc98-312b-4d60-97bb-be9b9c2b0d34,54956bf4-79e4-434d-8bdd-3deda3cb9131

# Flask Session Security
FLASK_SECRET_KEY=replace_with_random_secret_key
SESSION_COOKIE_SECURE=true
